---
/**
 * The editorial inversion.
 *
 * One deliberate colour change: after the dark film, the page becomes paper.
 * It signals "the film is over, now read" and it is the only place where the
 * palette is inverted. Cards are hairline-bordered, not translucent — on paper
 * there is nothing behind a card to show through.
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';
import { FACTS } from '../data/facts';
---

<section id="datos" class="datos">
  <div class="wrap">
    <header class="head">
      <p class="label eyebrow">Los datos</p>
      <h2>La papa no cabe<br />en una cifra</h2>
      <p class="intro">
        Cuatro mil variedades no se explican con un número. Lo que sigue son tres datos
        concretos, cada uno con su fuente, porque una cifra sin origen es una opinión.
      </p>
    </header>

    <ul class="grid">
      {
        FACTS.map((fact) => (
          <li class="card" style={`--accent:${fact.accent}`}>
            <span class="badge">
              <Icon name={fact.icon as IconName} size={22} />
            </span>
            <p class="label">{fact.label}</p>
            <p class="value">{fact.value}</p>
            <p class="body">{fact.body}</p>
            <p class="source">
              <a href={fact.source.url} target="_blank" rel="noopener noreferrer">
                {fact.source.name}
                <Icon name="external" size={13} />
              </a>
              <span class="year">{fact.source.year}</span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .datos {
    /* The inversion, scoped to this section only. */
    background: var(--paper);
    color: var(--ink);
    padding: var(--section-pad) 0;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }

  .eyebrow {
    color: var(--ink-soft);
    margin: 0;
  }

  h2 {
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0;
  }

  .intro {
    margin: 0;
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem 1.5rem 1.35rem;
    background: var(--paper-surface);
    border: 1px solid var(--rule);
    border-radius: 6px;
  }

  /* The accent lives in a hairline, not in text: on paper these hues are too
     light to carry small type. */
  .card::before {
    content: '';
    position: absolute;
    inset: -1px -1px auto -1px;
    height: 2px;
    background: var(--accent);
    border-radius: 6px 6px 0 0;
  }

  .badge {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.65rem;
    background: rgb(10 9 8 / 0.05);
    color: var(--ink);
    margin-bottom: 0.25rem;
  }

  .card .label {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.64rem;
  }

  .value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
  }

  .body {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .source {
    margin: auto 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.72rem;
    color: var(--ink-soft);
  }

  .source a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid rgb(10 9 8 / 0.28);
    padding-bottom: 1px;
  }

  .source a:hover {
    border-bottom-color: var(--ink);
  }

  .year {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
